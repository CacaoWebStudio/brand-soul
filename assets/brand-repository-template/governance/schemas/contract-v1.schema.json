{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brand-soul:contract:v1",
  "title": "Brand Soul Context Contract V1",
  "type": "object",
  "required": ["contract_version", "brand", "repository_status", "brand_state", "canonical_files", "governance_files", "protected_files", "consumer_rules"],
  "properties": {
    "contract_version": {"const": 1},
    "brand": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "repository_status": {"enum": ["draft", "usable_with_gaps", "approved"]},
    "brand_state": {
      "type": "object",
      "required": ["maturity", "evidence_coverage", "identity_coherence"],
      "properties": {
        "maturity": {"enum": ["new", "emerging", "existing"]},
        "evidence_coverage": {"enum": ["sparse", "partial", "substantial"]},
        "identity_coherence": {"enum": ["undefined", "inconsistent", "coherent"]}
      },
      "additionalProperties": false
    }
  }
}
